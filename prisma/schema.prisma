// Prisma schema for the album-tracking app (Neon PostgreSQL, multi-user)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String?
  bio             String?
  avatarUrl       String?
  coverUrl        String?
  favoriteAlbumId String?
  featuredTab     String   @default("diary") // "diary" | "lists" | "stats"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  statuses         AlbumStatus[]
  logs             ListenLog[]
  lists            List[]
  externalAccounts ExternalAccount[]

  favoriteAlbum     Album?         @relation("FavoriteAlbum", fields: [favoriteAlbumId], references: [id], onDelete: SetNull)
  followers         Follow[]       @relation("following") // people following ME
  following         Follow[]       @relation("follower") // people I follow
  notifications     Notification[] @relation("recipient")
  notificationsSent Notification[] @relation("actor")
  pinnedLists       PinnedList[]

  recommendationsSent     AlbumRecommendation[] @relation("RecommendationsSent")
  recommendationsReceived AlbumRecommendation[] @relation("RecommendationsReceived")
  shameNotesAuthored      ShameNote[]           @relation("ShameNotesSent")
  shameNotesReceived      ShameNote[]           @relation("ShameNotesReceived")

  listeningGroupsCreated     ListeningGroup[]         @relation("ListeningGroupCreator")
  listeningGroupMemberships  ListeningGroupMember[]   @relation("ListeningGroupMemberUser")
  listeningSessionsCreated   ListeningSession[]       @relation("ListeningSessionCreator")
  listeningSessionRatings    ListeningSessionRating[] @relation("ListeningSessionRatingUser")
  sessionVotesOpened         ListeningSessionVote[]   @relation("SessionVoteOpener")
  sessionVoteCandidatesAdded SessionVoteCandidate[]   @relation("SessionVoteCandidateProposer")
  sessionVoteBallotsCast     SessionVoteBallot[]      @relation("SessionVoteBallotCaster")
}

model ExternalAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "SPOTIFY" — SQLite has no native enum support in Prisma
  providerAccountId String
  accessToken       String
  refreshToken      String
  expiresAt         DateTime
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, provider])
}

model Album {
  id          String   @id @default(cuid())
  mbid        String   @unique
  title       String
  artist      String
  coverUrl    String?
  releaseDate String?
  createdAt   DateTime @default(now())

  logs                  ListenLog[]
  listEntries           ListEntry[]
  status                AlbumStatus[]
  favoritedByUsers      User[]                 @relation("FavoriteAlbum")
  notifications         Notification[]
  tracks                Track[]
  recommendations       AlbumRecommendation[]
  listeningSessions     ListeningSession[]
  sessionVoteCandidates SessionVoteCandidate[]
}

model Track {
  id          String   @id @default(cuid())
  albumId     String
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  spotifyId   String
  title       String
  trackNumber Int
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@unique([albumId, spotifyId])
  @@index([albumId])
}

model AlbumStatus {
  id           String   @id @default(cuid())
  albumId      String
  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  liked        Boolean  @default(false)
  wantToListen Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([albumId, userId])
}

model ListenLog {
  id         String   @id @default(cuid())
  albumId    String
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int?
  review     String?
  listenedOn DateTime @default(now())
  relisten   Boolean  @default(false)
  createdAt  DateTime @default(now())

  notifications   Notification[]
  recommendations AlbumRecommendation[]

  @@index([userId])
  @@index([albumId])
}

model List {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  entries       ListEntry[]
  pinnedBy      PinnedList[]
  notifications Notification[]

  @@index([userId])
}

model ListEntry {
  id       String   @id @default(cuid())
  listId   String
  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  albumId  String
  album    Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  position Int      @default(0)
  addedAt  DateTime @default(now())

  @@unique([listId, albumId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id          String     @id @default(cuid())
  recipientId String
  recipient   User       @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User       @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  type        String // "FOLLOW" | "LISTEN_LOG" | "LIST_CREATED" | "RECOMMENDATION" | "RECOMMENDATION_COMPLETED" | "SHAME_NOTE"
  albumId     String?
  album       Album?     @relation(fields: [albumId], references: [id], onDelete: SetNull)
  listId      String?
  list        List?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  listenLogId String?
  listenLog   ListenLog? @relation(fields: [listenLogId], references: [id], onDelete: Cascade)
  read        Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model PinnedList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, listId])
  @@index([userId])
}

// A user recommends an album to a mutual-follow friend. The friend has 7 days
// (createdAt -> expiresAt) to listen and write a review; status is always
// derived (never stored) from listenLogId/expiresAt/shameNote — see
// src/lib/friendship.ts, same lazy-compute approach as src/lib/streak.ts.
model AlbumRecommendation {
  id          String     @id @default(cuid())
  fromUserId  String
  fromUser    User       @relation("RecommendationsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User       @relation("RecommendationsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  albumId     String
  album       Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  message     String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  listenLogId String? // not @unique: one review can fulfill recommendations from several friends
  listenLog   ListenLog? @relation(fields: [listenLogId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  shameNote   ShameNote?

  @@index([toUserId])
  @@index([fromUserId])
  @@index([albumId])
}

// Left by the recommender on the recipient's profile once a recommendation
// has expired unfulfilled — visible publicly on that profile.
model ShameNote {
  id               String              @id @default(cuid())
  recommendationId String              @unique
  recommendation   AlbumRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                @relation("ShameNotesSent", fields: [authorId], references: [id], onDelete: Cascade)
  targetUserId     String
  targetUser       User                @relation("ShameNotesReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  text             String
  createdAt        DateTime            @default(now())

  @@index([targetUserId])
}

// A shared listening group. Only the creator manages membership; any member
// can schedule sessions and rate them.
model ListeningGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdBy   User     @relation("ListeningGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members  ListeningGroupMember[]
  sessions ListeningSession[]

  @@index([createdById])
}

model ListeningGroupMember {
  id       String         @id @default(cuid())
  groupId  String
  group    ListeningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("ListeningGroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// A scheduled joint listen. The album is picked at creation time, at random,
// from the pool of albums the group's members have liked, want to listen to,
// or have already logged — see src/lib/groups.ts (pickAlbumForGroup).
model ListeningSession {
  id           String         @id @default(cuid())
  groupId      String
  group        ListeningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  albumId      String
  album        Album          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("ListeningSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  ratings ListeningSessionRating[]
  votes   ListeningSessionVote[]

  @@index([groupId])
  @@index([albumId])
}

// One member's rating for a session's album. The group's average rating for
// an album (across all its sessions) is derived from these, never stored.
model ListeningSessionRating {
  id        String           @id @default(cuid())
  sessionId String
  session   ListeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("ListeningSessionRatingUser", fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  review    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// A poll to replace a session's album, opened by whoever created the
// session or the group's owner (see canManageSession in src/lib/groups.ts).
// At most one open (closedAt == null) vote per session is allowed — enforced
// in the API, not the DB, since Prisma has no cross-db partial unique index.
// Closes automatically once every group member has cast a ballot; the
// candidate with the most ballots wins (ties broken at random) and becomes
// the session's album.
model ListeningSessionVote {
  id             String           @id @default(cuid())
  sessionId      String
  session        ListeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  openedById     String
  openedBy       User             @relation("SessionVoteOpener", fields: [openedById], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  closedAt       DateTime?
  winningAlbumId String?

  candidates SessionVoteCandidate[]
  ballots    SessionVoteBallot[]

  @@index([sessionId])
}

model SessionVoteCandidate {
  id           String               @id @default(cuid())
  voteId       String
  vote         ListeningSessionVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  albumId      String
  album        Album                @relation(fields: [albumId], references: [id], onDelete: Cascade)
  proposedById String
  proposedBy   User                 @relation("SessionVoteCandidateProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  ballots SessionVoteBallot[]

  @@unique([voteId, albumId])
  @@index([voteId])
}

model SessionVoteBallot {
  id          String               @id @default(cuid())
  voteId      String
  vote        ListeningSessionVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   SessionVoteCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User                 @relation("SessionVoteBallotCaster", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([voteId, userId])
  @@index([voteId])
  @@index([candidateId])
}
